const filteredSensorReadings = (() => {
  if (sensorReadings.length === 0) {
    return []
  }

  const sortedReadings = [...sensorReadings]
    .filter(
      (reading) =>
        !isNaN(
          new Date(
            reading.recorded_at
          ).getTime()
        )
    )
    .sort(
      (a, b) =>
        new Date(
          a.recorded_at
        ).getTime() -
        new Date(
          b.recorded_at
        ).getTime()
    )

  if (sortedReadings.length === 0) {
    return []
  }

  const latestTime =
    new Date(
      sortedReadings[
        sortedReadings.length - 1
      ].recorded_at
    ).getTime()

  const hours = {
    '1H': 1,
    '24H': 24,
    '7D': 24 * 7,
    '30D': 24 * 30
  }

  const rangeMilliseconds =
    (hours[historyRange] || 24) *
    60 *
    60 *
    1000

  const startTime =
    latestTime -
    rangeMilliseconds

  return sortedReadings.filter(
    (reading) => {
      const readingTime =
        new Date(
          reading.recorded_at
        ).getTime()

      return (
        readingTime >= startTime &&
        readingTime <= latestTime
      )
    }
  )
})()


/* =========================================================
   GET LATEST SENSOR VALUE
   IMPORTANT:
   Uses the newest recorded_at value
========================================================= */

const getLatestSensorValue = (
  sensorType
) => {

  const readingsOfType =
    sensorReadings
      .filter(
        (item) =>
          item.sensor_type === sensorType
      )
      .filter(
        (item) =>
          !isNaN(
            new Date(
              item.recorded_at
            ).getTime()
          )
      )
      .sort(
        (a, b) =>
          new Date(
            b.recorded_at
          ).getTime() -
          new Date(
            a.recorded_at
          ).getTime()
      )

  if (
    readingsOfType.length === 0
  ) {
    return null
  }

  return Number(
    readingsOfType[0].value
  )
}


